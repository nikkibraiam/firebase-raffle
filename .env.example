# Example values: they run fully offline against the Firebase Emulator Suite.
# Project ids starting with "demo-" never touch a real Firebase project.
# For your own project, copy the web app config from
# Firebase console -> Project settings -> Your apps, and set VITE_USE_EMULATORS=false.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-rifas.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-rifas
VITE_FIREBASE_STORAGE_BUCKET=demo-rifas.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_USE_EMULATORS=true
